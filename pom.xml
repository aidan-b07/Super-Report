<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.aidanbooth</groupId>
    <artifactId>SuperReport</artifactId>
    <version>2.1</version>
    <packaging>jar</packaging>

    <name>SuperReport</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Bytecode stays Java 8 so one jar loads on every server from 1.8.8 to the latest -->
        <maven.compiler.release>8</maven.compiler.release>

        <!--
            Local test server. Each Minecraft version gets its own folder: run/<server.version>/
            Pick one with -Dserver.version=1.8.8 (the IntelliJ "Paper x.y" run configs do this).
            If run/<version>/server.jar is missing, the latest Paper build for that version is downloaded.
            Skip all of this (e.g. on CI) with -Dserver.skip=true.
        -->
        <server.version>26.3</server.version>
        <server.skip>false</server.skip>
        <test.server.dir>${project.basedir}/run/${server.version}</test.server.dir>
    </properties>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <minimizeJar>true</minimizeJar>
                            <relocations>
                                <!-- XSeries asks users to relocate so we never clash with another plugin's copy -->
                                <relocation>
                                    <pattern>com.cryptomorin.xseries.</pattern>
                                    <shadedPattern>dev.aidanbooth.superreport.libs.xseries.</shadedPattern>
                                </relocation>
                                <!-- JDA and its libraries, so another plugin's copy (DiscordSRV etc.) can't clash with ours -->
                                <relocation>
                                    <pattern>net.dv8tion.</pattern>
                                    <shadedPattern>dev.aidanbooth.superreport.libs.dv8tion.</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.neovisionaries.</pattern>
                                    <shadedPattern>dev.aidanbooth.superreport.libs.neovisionaries.</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>okhttp3.</pattern>
                                    <shadedPattern>dev.aidanbooth.superreport.libs.okhttp3.</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>okio.</pattern>
                                    <shadedPattern>dev.aidanbooth.superreport.libs.okio.</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>kotlin.</pattern>
                                    <shadedPattern>dev.aidanbooth.superreport.libs.kotlin.</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.fasterxml.jackson.</pattern>
                                    <shadedPattern>dev.aidanbooth.superreport.libs.jackson.</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>gnu.trove.</pattern>
                                    <shadedPattern>dev.aidanbooth.superreport.libs.trove.</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.commons.collections4.</pattern>
                                    <shadedPattern>dev.aidanbooth.superreport.libs.collections4.</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.slf4j.</pattern>
                                    <shadedPattern>dev.aidanbooth.superreport.libs.slf4j.</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.bstats.</pattern>
                                    <shadedPattern>dev.aidanbooth.superreport.libs.bstats.</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <!-- From XSeries we only want XMaterial and the one base class it depends on -->
                                <filter>
                                    <artifact>com.github.cryptomorin:XSeries</artifact>
                                    <includes>
                                        <include>com/cryptomorin/xseries/XMaterial*.class</include>
                                        <include>com/cryptomorin/xseries/base/XBase*.class</include>
                                    </includes>
                                </filter>
                                <!-- minimizeJar only keeps classes it can see being used. These load some classes
                                     by name at runtime, so keep them whole -->
                                <filter>
                                    <artifact>net.dv8tion:JDA</artifact>
                                    <includes><include>**</include></includes>
                                </filter>
                                <filter>
                                    <artifact>com.fasterxml.jackson.core:*</artifact>
                                    <includes><include>**</include></includes>
                                </filter>
                                <filter>
                                    <artifact>com.squareup.okhttp3:*</artifact>
                                    <includes><include>**</include></includes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!-- Renames META-INF/services files to the relocated names, so our SLF4J copy finds JdaLogProvider -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- After shading: fetch a Paper server for ${server.version} if needed, then install the plugin into it -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>deploy-to-test-server</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${server.skip}</skip>
                            <!-- The download/install steps live in tools/test-server.xml -->
                            <target>
                                <ant antfile="${project.basedir}/tools/test-server.xml" inheritAll="false">
                                    <property name="server.version" value="${server.version}"/>
                                    <property name="server.dir" value="${test.server.dir}"/>
                                    <property name="plugin.jar" value="${project.build.directory}/${project.build.finalName}.jar"/>
                                    <property name="plugin.name" value="${project.artifactId}.jar"/>
                                    <property name="eula.file" value="${project.basedir}/run/eula.txt"/>
                                    <property name="work.dir" value="${project.build.directory}"/>
                                </ant>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Compile against the oldest supported API; newer servers stay backwards compatible with it -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.8.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
            <exclusions>
                <!-- Purged from the Spigot repo and unused by this plugin -->
                <exclusion>
                    <groupId>net.md-5</groupId>
                    <artifactId>bungeecord-chat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <version>6.7.0</version>
            <exclusions>
                <!-- Voice only (audio codec, its native libraries and voice encryption). The bot only sends messages -->
                <exclusion>
                    <groupId>club.minnced</groupId>
                    <artifactId>opus-java</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.crypto.tink</groupId>
                    <artifactId>tink</artifactId>
                </exclusion>
                <!-- Annotations only, not needed at runtime -->
                <exclusion>
                    <groupId>org.jetbrains</groupId>
                    <artifactId>annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Cross-version materials. Only XMaterial is shaded in (see the shade filter) -->
        <dependency>
            <groupId>com.github.cryptomorin</groupId>
            <artifactId>XSeries</artifactId>
            <version>14.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>
        <!-- Servers provide the driver at runtime; the tests need their own -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.54.1.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.2.1</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>
